{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "site",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,

  // Static assets come from the Vite build. The API and the admin area reach the Worker first, so
  // the owner gate sees them (design doc §4.9.1).
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"],
    // Serve prerendered blog/index.html at /blog (no trailing-slash redirect).
    "html_handling": "drop-trailing-slash",
  },

  // One Durable Object per game lobby (design doc §4.5), and one per online Power Volley room,
  // which runs the match itself (worker/volley-room.ts).
  "durable_objects": {
    "bindings": [
      { "name": "GAME_LOBBY", "class_name": "GameLobby" },
      { "name": "VOLLEY_ROOM", "class_name": "VolleyRoom" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameLobby"] },
    { "tag": "v2", "new_sqlite_classes": ["VolleyRoom"] },
  ],

  // POST /api/lobbies is limited per client IP. Config can't import game-core, so `limit` must be
  // kept equal to LOBBY_CREATE_LIMIT_PER_MINUTE there (the unit and e2e tests use that constant).
  "ratelimits": [
    {
      "name": "LOBBY_CREATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
    // POST /api/tycoon/players (a new anonymous Pipeline Tycoon player), per client IP.
    {
      "name": "TYCOON_PLAYER_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 5, "period": 60 },
    },
  ],

  // Production domain (hosting guide §2.5). www never reaches the Worker: it
  // has a proxied placeholder DNS record and a redirect rule to the bare domain.
  "routes": [{ "pattern": "ry-mart.com", "custom_domain": true }],

  // Cloudflare Access covers only ry-mart.com, so no other hostname may serve this Worker.
  "workers_dev": false,
  "preview_urls": false,

  // Drafts for the editor (design doc §4.9.5). The id isn't secret. deploy.yml applies the
  // migrations before each deploy, and e2e applies them locally.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blog",
      "database_id": "adb4e0b8-b513-464e-bff6-4c0faab3dfa0",
      "migrations_dir": "migrations",
    },
    // Pipeline Tycoon saves (docs/04-pipeline-tycoon.md §2.4), kept apart from the blog.
    {
      "binding": "TYCOON_DB",
      "database_name": "tycoon",
      "database_id": "721ee66f-fd87-490a-ab79-ddf0d394c572",
      "migrations_dir": "migrations-tycoon",
    },
  ],

  // The public photos bucket (photos.ry-mart.com). The Worker only touches the editor's image
  // keys under blog/: it uploads them and deletes unpublished ones (design doc §4.9.6).
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "photos" }],

  // The daily clean-up of abandoned image uploads (worker/images.ts, `cleanUpImages`).
  "triggers": { "crons": ["23 4 * * *"] },

  // Cloudflare Access for the admin area (hosting guide §2.7); neither value is secret. If either
  // is empty or malformed, the owner gate refuses every admin request. The owner's e-mail is the
  // OWNER_EMAIL secret, never a var.
  //
  // GIT_AUTHOR is the author of every commit the editor publishes: the owner's GitHub no-reply
  // identity, because commits are public history (design doc §4.9.7). It is never OWNER_EMAIL, and
  // publishing refuses to run if it holds that address. The App's own key, client id and
  // installation id are Worker secrets.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://tight-boat-6333.cloudflareaccess.com",
    "ACCESS_AUD": "7ae08ee40e3b5eb832ad77322d4cf20f0459d08490194adedb349dd6a963a31f",
    "GIT_AUTHOR": "TheRizz <19941577+TheRizz@users.noreply.github.com>",
  },
}

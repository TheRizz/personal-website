{
  "name": "personal-website",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "content": "tsx scripts/build-content.ts",
    "dev": "pnpm content --drafts && pnpm --filter web dev",
    "build": "pnpm content && pnpm --filter web build",
    "lint": "eslint .",
    "typecheck": "pnpm content && pnpm -r typecheck && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "1.56.1",
    "@shikijs/rehype": "^4.5.0",
    "@site/content-schema": "workspace:*",
    "@types/hast": "^3.0.4",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "gray-matter": "^4.0.3",
    "hast-util-to-string": "^3.0.1",
    "prettier": "^3.6.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.5.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vitest": "^5.0.3"
  }
}

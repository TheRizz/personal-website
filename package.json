{
  "name": "personal-website",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "content": "tsx scripts/build-content.ts",
    "dev": "pnpm content --drafts && pnpm db:migrate:local && pnpm --filter web dev",
    "build": "pnpm content && pnpm --filter web build",
    "check:bundle": "tsx scripts/check-public-bundle.ts",
    "db:migrate:local": "pnpm --filter web db:migrate:local",
    "lint": "eslint .",
    "typecheck": "pnpm content && pnpm -r typecheck && tsc -p tsconfig.scripts.json && tsc -p e2e/tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:keys": "tsx scripts/e2e-keys.ts",
    "app-token": "tsx scripts/app-token.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "1.56.1",
    "@site/content-markdown": "workspace:*",
    "@site/content-schema": "workspace:*",
    "@site/tycoon-core": "workspace:*",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.13.0",
    "gray-matter": "^4.0.3",
    "prettier": "^3.6.0",
    "shiki": "^4.5.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
